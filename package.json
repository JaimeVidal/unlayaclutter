{
  "name": "unlayaclutter",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaimeVidal/unlayaclutter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "server:setup": "python3 -m venv server/.venv && server/.venv/bin/pip install -r server/requirements.txt",
    "server": "server/.venv/bin/python server/laya_server.py",
    "smoke": "LAYA_LOCAL=1 tsx scripts/smoke.ts",
    "try": "tsx scripts/try-page.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "server:install": "./server/install-agent.sh",
    "server:uninstall": "./server/install-agent.sh uninstall",
    "harvest": "tsx scripts/harvest.ts",
    "label": "tsx scripts/make-labeller.ts && open data/label.html"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "wxt": "0.21.4"
  }
}
